<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Desktop.ViewModels"
        xmlns:entities="clr-namespace:Domain.Entities;assembly=Domain"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Desktop.Views.MainWindow"
        x:DataType="viewModels:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KnotNotes - Local Knowledge Graph">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="300, *">
        
        <!-- Top Bar: Folder Selection -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="15" Margin="10" VerticalAlignment="Center">
            <Button Content="📁 Browse Course Folder..." 
                    Click="OnBrowseFolderClick" 
                    Padding="10,6"/>
            <TextBlock Text="{Binding RootDirectoryPath}" 
                       VerticalAlignment="Center" 
                       Foreground="DarkGray" 
                       FontStyle="Italic" />
        </StackPanel>

        <!-- Left Sidebar: Note List -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,1,0" Margin="0,5,0,0">
            <DockPanel>
                <TextBlock Text="Workspace Notes" FontWeight="Bold" Margin="10" DockPanel.Dock="Top"/>
                <ListBox ItemsSource="{Binding AllNotes}"
                         SelectedItem="{Binding SelectedNote}"
                         Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="Gray" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right Pane: Note Content / Preview Area -->
        <!-- Right Pane: Note Content / Preview Area -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="15">
            <ContentControl Content="{Binding SelectedNote}">
                <ContentControl.DataTemplates>
                    
                    <!-- Template for Markdown Notes -->
                    <DataTemplate DataType="entities:MarkdownNote">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="Gray" />
                            
                            <!-- Display Tags -->
                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#333333" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#00FFFF" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <Separator Margin="0,5,0,10" />
                            
                            <!-- Raw Markdown Content Preview -->
                            <TextBox Text="{Binding Content}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0" />
                        </StackPanel>
                    </DataTemplate>

                    <!-- Template for PDF Document Nodes -->
                    <DataTemplate DataType="entities:PdfDocumentNode">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="Gray" />
                            <Separator Margin="0,5,0,10" />
                            
                            <TextBlock Text="Extracted PDF Text:" FontWeight="SemiBold" />
                            <TextBox Text="{Binding ExtractedText}"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     BorderThickness="0" />
                        </StackPanel>
                    </DataTemplate>

                </ContentControl.DataTemplates>
            </ContentControl>
        </ScrollViewer>

    </Grid>
</Window>